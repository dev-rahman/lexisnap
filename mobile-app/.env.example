# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit real secrets.

# Supabase project settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# "Publishable key" (formerly "anon" key). Safe for client apps.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Google Cloud Console > APIs & Services > Credentials
# iOS OAuth client ID (type: iOS)
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# Web OAuth client ID (type: Web application) - used as the "server client id"
# so Supabase can verify Google ID tokens on both Android and iOS.
GOOGLE_SERVER_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Inbox "Contact support" messages get addressed to (opens the user's own
# mail app - no backend needed). Replace with your real support address.
SUPPORT_EMAIL=support@lexisnap.app

# Cloudflare Turnstile SITE key (public, safe in the app). Leave empty to
# skip the captcha. Only set it together with turning CAPTCHA on in the
# Supabase dashboard (Authentication > Attack Protection) - the SECRET key
# goes there, never in this file.
TURNSTILE_SITE_KEY=

# EmailJS, used by the in-app support form (docs/emailjs/SETUP.md). Leave
# empty to fall back to opening the user's mail app. SERVICE_ID + PUBLIC_KEY
# + both TEMPLATE ids are required to send; PRIVATE_KEY is needed when EmailJS
# blocks non-browser calls (the default).
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Template that emails the request to your support inbox.
EMAILJS_TEMPLATE_SUPPORT=
# Template that emails the user their copy.
EMAILJS_TEMPLATE_RECEIPT=
