# Copy to .env.local and fill in. Reuses the SAME Supabase project as the
# Flutter app (see ../.env). Only public/client-safe values live here.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# "Publishable"/anon key — client-safe, only grants what RLS allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Cloudflare Turnstile SITE key (public). Leave empty to skip the captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`.
# The PUBLIC key is safe here; the PRIVATE key goes ONLY in the Supabase
# secret for the send-study-reminders function, never in this file.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Support inbox for the help form's mailto fallback.
NEXT_PUBLIC_SUPPORT_EMAIL=support@lexisnap.app

# EmailJS (support form). PUBLIC key + service + template ids are client-safe.
# The PRIVATE key must NOT go here — it is used only by the server route
# handler (set it as EMAILJS_PRIVATE_KEY, unprefixed, in the server env).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TEMPLATE_SUPPORT=
NEXT_PUBLIC_EMAILJS_TEMPLATE_RECEIPT=
EMAILJS_PRIVATE_KEY=
